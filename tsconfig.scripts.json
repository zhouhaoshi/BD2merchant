{
  "extends": "./tsconfig.node.json",
  "include": ["scripts/**/*.ts", "src/utils/*.d.ts", "src/element.d.ts"],
  "exclude": ["scripts/tmp-*.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true
  }
}
